# Copy to .env on the development PC and replace the placeholder with a random secret.
# Never commit .env or use this example value as a production credential.
HAEJUMI_BIND_HOST=127.0.0.1
HAEJUMI_PORT=8765
HAEJUMI_OWNER_ID=local-owner
HAEJUMI_BEARER_TOKEN=replace-with-a-long-random-secret-before-starting
HAEJUMI_DATA_DIR=./data
HAEJUMI_MAX_MEDIA_BYTES=52428800
