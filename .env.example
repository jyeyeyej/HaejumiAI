# Copy to .env on the development PC and replace the placeholder with a random secret.
# Never commit .env or use this example value as a production credential.
HAEJUMI_BIND_HOST=127.0.0.1
HAEJUMI_PORT=8765
HAEJUMI_OWNER_ID=local-owner
HAEJUMI_BEARER_TOKEN=
HAEJUMI_DATA_DIR=./data
HAEJUMI_MAX_MEDIA_BYTES=52428800
HAEJUMI_LLM_ENABLED=false
HAEJUMI_LLM_DAILY_BUDGET_USD=0.20
HAEJUMI_LLM_MONTHLY_BUDGET_USD=5
HAEJUMI_LLM_MAX_CALLS_PER_TASK=5
HAEJUMI_LLM_MAX_REVISIONS_PER_TASK=3
HAEJUMI_OPENAI_API_KEY=
HAEJUMI_OPENAI_MODEL=
HAEJUMI_OPENAI_TIMEOUT_MS=20000
HAEJUMI_OPENAI_MAX_IMAGES_PER_ANALYSIS=5
HAEJUMI_LLM_ESTIMATED_COST_PER_ITEM_USD=0.01
